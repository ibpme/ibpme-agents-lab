{
  "name": "@agent-hub/workspace",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0",
    "npm": ">=10"
  },
  "packageManager": "npm@11.19.0",
  "workspaces": [
    "registry",
    "viewer",
    "pi",
    "spawner",
    "mcp",
    "service"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test:packages && npm run test --workspaces",
    "check": "npm run typecheck && npm test",
    "test:packages": "node --test scripts/packages.test.mjs",
    "cli:install": "npm run cli:install --workspace @agent-hub/service",
    "cli:uninstall": "npm run cli:uninstall --workspace @agent-hub/service"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "5.9.3"
  }
}
