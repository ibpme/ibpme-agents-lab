{
  "name": "@agent-hub/service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "agent-hub": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "cli:install": "node scripts/install-cli.mjs install",
    "cli:uninstall": "node scripts/install-cli.mjs uninstall"
  },
  "dependencies": {
    "@agent-hub/registry": "0.1.0",
    "@agent-hub/spawner": "0.1.0",
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "@types/proper-lockfile": "^4.1.4"
  }
}
