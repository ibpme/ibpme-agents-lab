{
  "name": "agents-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Discover, message and spawn local coding agents through MCP",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "agents-mcp": "dist/cli.js"
  },
  "scripts": {
    "build": "npm --prefix ../spawner run build && tsc -p tsconfig.json",
    "typecheck": "npm --prefix ../spawner run build && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "npm run build && tsx --test test/*.test.ts",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "express": "^5.2.1",
    "zod": "^4.0.0",
    "@agent-hub/spawner": "file:../spawner"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
