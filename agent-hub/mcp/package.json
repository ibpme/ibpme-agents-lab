{
  "name": "@agent-hub/mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Discover, message and spawn local coding agents through MCP",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "agents-mcp": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "npm run build && tsx --test test/*.test.ts",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "express": "^5.2.1",
    "zod": "^4.0.0",
    "@agent-hub/spawner": "0.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@agent-hub/pi": "0.1.0",
    "@agent-hub/registry": "0.1.0"
  }
}
