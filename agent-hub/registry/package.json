{
  "name": "@agent-hub/registry",
  "version": "0.1.0",
  "private": true,
  "description": "Machine-local Pi and Claude agent registry daemon",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "agents-registry": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "npm run build && tsx --test tests/*.test.ts tests/*.test.mjs",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "cli:install": "node scripts/install-cli.mjs install",
    "cli:uninstall": "node scripts/install-cli.mjs uninstall"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "@types/proper-lockfile": "^4.1.4"
  },
  "exports": {
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./processes": {
      "types": "./dist/discovery/processes.d.ts",
      "import": "./dist/discovery/processes.js"
    },
    "./schemas/*": "./schemas/*",
    "./daemon": {
      "types": "./dist/daemon.d.ts",
      "import": "./dist/daemon.js"
    },
    "./paths": {
      "types": "./dist/paths.d.ts",
      "import": "./dist/paths.js"
    }
  }
}
