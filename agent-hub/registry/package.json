{
  "name": "@agent-hub/registry",
  "version": "0.1.0",
  "private": true,
  "description": "Machine-local Pi and Claude agent registry daemon",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test 'tests/*.test.ts' 'tests/*.test.mjs'"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "@types/proper-lockfile": "^4.1.4"
  },
  "exports": {
    "./client": "./src/client.ts",
    "./types": "./src/types.ts",
    "./processes": "./src/discovery/processes.ts",
    "./schemas/*": "./schemas/*",
    "./daemon": "./src/daemon.ts",
    "./paths": "./src/paths.ts",
    "./protocol": "./src/protocol.ts",
    "./publishers/claude/*": "./publishers/claude/*"
  }
}
