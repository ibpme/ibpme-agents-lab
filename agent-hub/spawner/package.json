{
  "name": "@agent-hub/spawner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "exports": {
    ".": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./supervisor": {
      "types": "./dist/supervisor.d.ts",
      "import": "./dist/supervisor.js"
    },
    "./tmux": {
      "types": "./dist/tmux.d.ts",
      "import": "./dist/tmux.js"
    }
  },
  "bin": {
    "agent-spawn": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "npm run build && node --experimental-strip-types --test test/*.test.ts test/*.test.mjs",
    "cli:install": "node scripts/install-cli.mjs install",
    "cli:uninstall": "node scripts/install-cli.mjs uninstall"
  },
  "dependencies": {
    "@agent-hub/pi": "0.1.0"
  }
}
